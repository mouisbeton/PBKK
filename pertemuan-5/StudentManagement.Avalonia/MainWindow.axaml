<Window x:Class="StudentManagement.Avalonia.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manajemen Mahasiswa" Width="1240" Height="840" WindowStartupLocation="CenterScreen" Background="#F1F5F9">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#1D4ED8" CornerRadius="8" Padding="20" Margin="0,0,0,18"><StackPanel><TextBlock Text="MANAJEMEN MAHASISWA" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="PBKK Pertemuan 5 | MVVM, Data Binding, dan SQL Server" Foreground="White" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Total mahasiswa" Foreground="#475569"/><TextBlock Text="{Binding TotalStudents}" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Informatika" Foreground="#475569"/><TextBlock Text="{Binding TotalInformatika}" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Sistem Informasi" Foreground="#475569"/><TextBlock Text="{Binding TotalSistemInformasi}" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Laki-laki" Foreground="#475569"/><TextBlock Text="{Binding TotalLakiLaki}" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="4" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Perempuan" Foreground="#475569"/><TextBlock Text="{Binding TotalPerempuan}" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,0"/></StackPanel></Border></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="8" Padding="20"><StackPanel>
<TextBlock Text="{Binding FormTitle}" FontWeight="Bold" FontSize="20" Margin="0,0,0,16"/>
<TextBlock Text="NIM"/><TextBox x:Name="txtNim" Text="{Binding Nim, Mode=TwoWay}" Height="34" Margin="0,5,0,13"/>
<TextBlock Text="Nama mahasiswa"/><TextBox x:Name="txtNama" Text="{Binding Nama, Mode=TwoWay}" Height="34" Margin="0,5,0,13"/>
<TextBlock Text="Jurusan"/><ComboBox x:Name="cmbJurusan" ItemsSource="{Binding Departments}" SelectedItem="{Binding Jurusan, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="34" Margin="0,5,0,13"/>
<TextBlock Text="Jenis kelamin"/><ComboBox x:Name="cmbGender" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="34" Margin="0,5,0,13"/>
<TextBlock Text="Email"/><TextBox x:Name="txtEmail" Text="{Binding Email, Mode=TwoWay}" Height="34" Margin="0,5,0,20"/>
<StackPanel Orientation="Horizontal"><Button x:Name="btnSimpan" Content="Simpan" Command="{Binding SaveCommand}" Width="135" Height="38" Background="#2563EB" Foreground="White" Margin="0,0,10,0"/><Button x:Name="btnReset" Content="Reset" Command="{Binding ResetCommand}" Width="115" Height="38"/></StackPanel>
</StackPanel></Border>
<Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="txtCari" Text="{Binding SearchText, Mode=TwoWay}" Height="36" Margin="0,0,10,0"/><Button x:Name="btnCari" Content="Cari" Command="{Binding SearchCommand}" Grid.Column="1" Height="36"/></Grid>
<DataGrid x:Name="gridStudents" Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
<DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="120"/><DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="170"/><DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="145"/><DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="110"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="btnHapus" Content="Hapus terpilih" Command="{Binding DeleteCommand}" Width="155" Height="36"/><TextBlock Text="Pilih baris untuk mengedit data." Foreground="#475569" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
<StackPanel Grid.Row="3" IsVisible="{Binding DeletePending}" Margin="0,12,0,0"><TextBlock Text="Setujui penghapusan data terpilih?" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="btnKonfirmasi" Content="Ya, hapus" Command="{Binding ConfirmDeleteCommand}" Width="120" Margin="0,0,10,0"/><Button x:Name="btnBatal" Content="Batal" Command="{Binding CancelDeleteCommand}" Width="100"/></StackPanel></StackPanel>
</Grid></Border></Grid>
<TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#1E40AF" Margin="0,14,0,0" TextWrapping="Wrap"/>
</Grid></Window>